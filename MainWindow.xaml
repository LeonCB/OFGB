<Window x:Class="OFGB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Background="#1E1E2E"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Title="OFGB"
        SizeToContent="WidthAndHeight">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="32"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Image Source="/Assets/OFGB.png" SnapsToDevicePixels="True" Panel.ZIndex="1" Margin="8,8,0,0" Height="16" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <Button Content="&#xe8bb;" x:Name="close" FontSize="10" Panel.ZIndex="1" Width="40" Click="Close" Height="32" WindowChrome.IsHitTestVisibleInChrome="True" />

        <CheckBox x:Name="cb1"  Margin="8,32,0,0"  Checked="Checked" Unchecked="Unchecked" Content="Verkenner-advertenties uitschakelen" />
        <CheckBox x:Name="cb2"  Margin="8,52,0,0"  Checked="Checked" Unchecked="Unchecked" Content="Vergrendelschermtips en -advertenties uitschakelen" />
        <CheckBox x:Name="cb3"  Margin="8,72,0,0"  Checked="Checked" Unchecked="Unchecked" Content="Instellingen-advertenties uitschakelen" />
        <CheckBox x:Name="cb4"  Margin="8,92,0,0"  Checked="Checked" Unchecked="Unchecked" Content="Algemene tips en advertenties uitschakelen" />
        <CheckBox x:Name="cb5"  Margin="8,112,0,0" Checked="Checked" Unchecked="Unchecked" Content="&quot;Configuratie voltooien&quot;-advertenties uitschakelen" />
        <CheckBox x:Name="cb6"  Margin="8,132,0,0" Checked="Checked" Unchecked="Unchecked" Content="&quot;Welkomstervaring&quot;-advertenties uitschakelen" />
        <CheckBox x:Name="cb7"  Margin="8,152,0,0" Checked="Checked" Unchecked="Unchecked" Content="Gepersonaliseerde advertenties uitschakelen" />
        <CheckBox x:Name="cb8"  Margin="8,172,0,0" Checked="Checked" Unchecked="Unchecked" Content="&quot;Ervaringen op maat&quot; uitschakelen" />
        <CheckBox x:Name="cb9"  Margin="8,192,0,0" Checked="Checked" Unchecked="Unchecked" Content="Startmenu-advertenties uitschakelen" />
        <CheckBox x:Name="cb10" Margin="8,212,0,0" Checked="Checked" Unchecked="Unchecked" Content="&quot;Meldingssuggesties&quot; uitschakelen" />
        <CheckBox x:Name="cb11" Margin="8,232,0,0" Checked="Checked" Unchecked="Unchecked" Content="Bing-resultaten in zoekfunctionaliteit uitschakelen" />
        <CheckBox x:Name="cb12" Margin="8,252,0,0" Checked="Checked" Unchecked="Unchecked" Padding="4,-1,10,23"  Content="Edge-zoekbalkwidget uitschakelen" />

        <TextBlock Foreground="Gray" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" TextAlignment="Left" Margin="0,0,8,5" TextWrapping="Wrap" Text="v0.4"/>
    </Grid>
</Window>
